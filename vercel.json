{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/duplicates.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    { "source": "/", "destination": "/api/duplicates", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
