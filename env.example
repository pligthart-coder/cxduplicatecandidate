# Carerix OAuth2 credentials — get these from Carerix → Identity Access → Clients
CARERIX_CLIENT_ID=your-client-id-here
CARERIX_CLIENT_SECRET=your-client-secret-here
CARERIX_TOKEN_ENDPOINT=https://yourcompany.carerix.com/cxoauth2/token

# Optional — base URL of your Carerix web app, used to build "Open candidate" deep links
# e.g. https://yourcompany.carerix.com
CARERIX_APP_BASE=
